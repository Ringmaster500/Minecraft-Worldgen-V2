{
  "$schema": "https://hytale.com/schemas/worldgen/v2/biome.json",
  "name": "VerdantForest",
  "zone": "Zone1_EmeraldGrove",
  "type": "TileBiome",
  "weight": 18.0,
  "sizeModifier": 1.4,
  "defaultTransitionDistance": 48.0,
  "maxSlopeForCover": 45.0,
  "minSpaceForCover": 3,
  "layers": [
    { "material": "hytale:grass_block", "thickness": 1 },
    { "material": "hytale:dirt", "thickness": 3 },
    { "material": "hytale:stone", "thickness": 999 }
  ],
  "fallbackMaterial": "hytale:stone",
  "cliffMaterial": "hytale:stone_andesite",
  "terrain": {
    "type": "SumDensity",
    "inputs": [
      {
        "type": "VerticalGradient",
        "baseHeight": 68.0,
        "scale": 28.0
      },
      {
        "type": "GradientWarpDensity",
        "input": {
          "type": "Noise2dDensity",
          "noiseType": "OpenSimplex2",
          "frequency": 0.0045,
          "octaves": 3,
          "amplitude": 0.50
        },
        "warpSource": {
          "type": "Noise2dDensity",
          "noiseType": "OpenSimplex2",
          "frequency": 0.008,
          "octaves": 2,
          "amplitude": 1.0
        },
        "warpStrength": 14.0
      },
      {
        "type": "CurveMapperDensity",
        "input": {
          "type": "YSampledDensity",
          "yInterval": 8,
          "input": {
            "type": "Noise3dDensity",
            "noiseType": "OpenSimplex2",
            "frequency": 0.011,
            "octaves": 3,
            "amplitude": 0.44
          }
        },
        "curve": {
          "type": "DistanceSCurve",
          "exponentA": 1.0,
          "exponentB": 1.0,
          "range": 1.0,
          "transition": 0.5,
          "transitionSmooth": 0.25
        }
      }
    ]
  },
  "materialProvider": {
    "type": "QueueMaterialProvider",
    "providers": [
      {
        "pattern": {
          "type": "AndPattern",
          "patterns": [
            { "type": "SurfacePattern" },
            { "type": "SlopePattern", "maxAngleDegrees": 45.0 },
            { "type": "SpaceCheckPattern", "minAirAbove": 3 }
          ]
        },
        "provider": {
          "type": "SpaceAndDepth",
          "layers": [
            { "material": "hytale:grass_block", "thickness": 1 },
            { "material": "hytale:dirt", "thickness": 3 },
            { "material": "hytale:stone", "thickness": 999 }
          ],
          "fallbackMaterial": "hytale:stone",
          "cliffMaterial": "hytale:stone_andesite",
          "maxSlopeForCover": 45.0,
          "minSpaceForCover": 3
        }
      },
      {
        "pattern": {
          "type": "AndPattern",
          "patterns": [
            { "type": "SurfacePattern" },
            { "type": "SlopePattern", "minAngleDegrees": 45.0 }
          ]
        },
        "provider": {
          "type": "WeightedMaterialProvider",
          "weights": [
            { "material": "hytale:stone", "weight": 65.0 },
            { "material": "hytale:stone_andesite", "weight": 25.0 },
            { "material": "hytale:gravel", "weight": 10.0 }
          ]
        }
      },
      {
        "pattern": { "type": "CeilingPattern" },
        "provider": {
          "type": "ConstantMaterialProvider",
          "material": "hytale:stone"
        }
      }
    ],
    "fallback": {
      "type": "ConstantMaterialProvider",
      "material": "hytale:stone"
    }
  }
}
